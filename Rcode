############################################################
# OFFLINE FITTED Q-EVALUATION WITH TEMPORAL CNN-LSTM
# + SPATIAL GRAPH FEATURES + CATE CLUSTERING
#
# Keras 3 + Reticulate Compatible
#
# Key Features:
#   1. Strict past-only spatial graph construction
#   2. Reticulate/Keras 3 direct object methods ($compile, $fit, $predict)
#   3. Multi-reward scalarization Bellman target updates
#   4. Doubly-Robust (DR), SNIPS, and IPS Off-Policy Evaluation
#   5. Silhouette-optimized CATE Clustering & PCA summary
############################################################

# ==========================================================
# 0. ENVIRONMENT SETUP
# ==========================================================

Sys.setenv(CUDA_VISIBLE_DEVICES = "-1")
Sys.setenv(TF_CPP_LOG_LEVEL = "2")

pkgs <- c(
  "keras",
  "tensorflow",
  "mclust",
  "cluster",
  "factoextra",
  "dplyr",
  "ggplot2",
  "nnet",
  "knitr",
